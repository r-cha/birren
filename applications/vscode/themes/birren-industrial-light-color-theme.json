{
  "name": "Birren Industrial Light",
  "type": "light",
  "semanticHighlighting": true,
  "colors": {
    "focusBorder": "#EEC902",
    "foreground": "#4B6E5B",
    "descriptionForeground": "#69867C",
    "errorForeground": "#7C0203",
    "selection.background": "#ADCED788",
    "textLink.foreground": "#026289",
    "textLink.activeForeground": "#E15602",
    "button.background": "#4F7B80",
    "button.foreground": "#E6DEAE",
    "button.hoverBackground": "#026289",
    "input.background": "#F0F0EA",
    "input.foreground": "#4B6E5B",
    "input.border": "#69867C",
    "dropdown.background": "#F0F0EA",
    "dropdown.foreground": "#4B6E5B",
    "dropdown.border": "#69867C",
    "badge.background": "#E15602",
    "badge.foreground": "#E6DEAE",
    "activityBar.background": "#4B6E5B",
    "activityBar.foreground": "#E6DEAE",
    "activityBar.inactiveForeground": "#E6DEAEAA",
    "activityBarBadge.background": "#EEC902",
    "activityBarBadge.foreground": "#4B6E5B",
    "sideBar.background": "#F0F0EA",
    "sideBar.foreground": "#4B6E5B",
    "sideBar.border": "#69867C",
    "sideBarTitle.foreground": "#4B6E5B",
    "list.activeSelectionBackground": "#ADCED7AA",
    "list.activeSelectionForeground": "#4B6E5B",
    "list.hoverBackground": "#F0F0EAAA",
    "list.inactiveSelectionBackground": "#ADCED766",
    "titleBar.activeBackground": "#4B6E5B",
    "titleBar.activeForeground": "#E6DEAE",
    "titleBar.inactiveBackground": "#4B6E5BDD",
    "titleBar.inactiveForeground": "#E6DEAEAA",
    "statusBar.background": "#4B6E5B",
    "statusBar.foreground": "#E6DEAE",
    "statusBar.noFolderBackground": "#4F7B80",
    "statusBar.debuggingBackground": "#E15602",
    "panel.background": "#F0F0EA",
    "panel.border": "#69867C",
    "tab.activeBackground": "#B6DAC0",
    "tab.activeForeground": "#4B6E5B",
    "tab.inactiveBackground": "#F0F0EA",
    "tab.inactiveForeground": "#69867C",
    "editor.background": "#B6DAC0",
    "editor.foreground": "#4B6E5B",
    "editorLineNumber.foreground": "#69867C",
    "editorLineNumber.activeForeground": "#4B6E5B",
    "editorCursor.foreground": "#026289",
    "editor.selectionBackground": "#ADCED7AA",
    "editor.inactiveSelectionBackground": "#ADCED766",
    "editor.lineHighlightBackground": "#F0F0EA66",
    "editor.findMatchBackground": "#FDF7B1CC",
    "editor.findMatchHighlightBackground": "#FDF7B177",
    "editor.wordHighlightBackground": "#ADCED755",
    "editorWhitespace.foreground": "#69867C88",
    "editorIndentGuide.background1": "#69867C66",
    "editorIndentGuide.activeBackground1": "#026289",
    "editorGutter.background": "#B6DAC0",
    "editorBracketMatch.background": "#FDF7B166",
    "editorBracketMatch.border": "#EEC902",
    "gitDecoration.addedResourceForeground": "#028339",
    "gitDecoration.modifiedResourceForeground": "#E15602",
    "gitDecoration.deletedResourceForeground": "#7C0203",
    "diffEditor.insertedTextBackground": "#02833933",
    "diffEditor.removedTextBackground": "#7C020333",
    "terminal.background": "#B6DAC0",
    "terminal.foreground": "#4B6E5B",
    "terminal.ansiBlack": "#4B6E5B",
    "terminal.ansiRed": "#7C0203",
    "terminal.ansiGreen": "#4E8C5A",
    "terminal.ansiYellow": "#988454",
    "terminal.ansiBlue": "#4F7B80",
    "terminal.ansiMagenta": "#E15602",
    "terminal.ansiCyan": "#026289",
    "terminal.ansiWhite": "#E6DEAE",
    "terminal.ansiBrightBlack": "#69867C",
    "terminal.ansiBrightRed": "#E15602",
    "terminal.ansiBrightGreen": "#028339",
    "terminal.ansiBrightYellow": "#EEC902",
    "terminal.ansiBrightBlue": "#026289",
    "terminal.ansiBrightMagenta": "#FDF7B1",
    "terminal.ansiBrightCyan": "#ADCED7",
    "terminal.ansiBrightWhite": "#F0F0EA"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#69867C",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#4E8C5A"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#E15602"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type"
      ],
      "settings": {
        "foreground": "#026289",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#4F7B80"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#988454"
      }
    },
    {
      "scope": [
        "variable",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#4B6E5B"
      }
    },
    {
      "scope": [
        "constant",
        "entity.name.constant"
      ],
      "settings": {
        "foreground": "#7C0203"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#4F7B80"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#4B6E5B"
      }
    }
  ]
}
